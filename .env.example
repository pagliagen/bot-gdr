# Copia questo file in ".env" e modifica i valori.

# Provider: "ollama" (locale, predefinito)
LLM_PROVIDER=ollama

# --- Ollama (locale) ---
# Serve un modello con supporto "tools" (controlla con: ollama show <modello>)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384

# --- Immagini generate in locale (opzionali) ---
# Modello di immagini di Ollama (ollama pull x/z-image-turbo, circa 12 GB). IMMAGINI=off le disattiva.
# IMMAGINI=on
# IMMAGINI_MODEL=x/z-image-turbo
# IMMAGINI_LARGHEZZA=1024
# IMMAGINI_ALTEZZA=576
# IMMAGINI_STEPS=9

# --- Interfaccia web: accesso ---
# Codice che serve per registrarsi. SENZA, nessuno può creare un account (e quindi giocare dal web).
CODICE_INVITO=cambiami
# Utenti che vedono il debug (spoiler!), separati da virgola. Gli altri non ricevono mai i tool.
ADMIN=
# Metti on se il sito è dietro HTTPS.
# COOKIE_SICURO=off
# Turni del narratore eseguiti insieme (la GPU è una).
# MAX_TURNI_CONTEMPORANEI=1

# --- Agente e memoria (opzionali) ---
# MAX_ITERAZIONI=8
# SOGLIA_MESSAGGI=40
# MESSAGGI_RECENTI=12

# --- Opzionale: provider Anthropic (non necessario) ---
# Per usarlo: pip install anthropic, LLM_PROVIDER=anthropic e queste variabili.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
